<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ShiftRecorder</AssemblyName>
    <Description>Record shifts from an independent camera</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.17" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="BBI.Unity.Game">
			<HintPath>$(ManagedDir)\BBI.Unity.Game.dll</HintPath>
		</Reference>
		<Reference Include="Carbon.Core">
			<HintPath>$(ManagedDir)\Carbon.Core.dll</HintPath>
		</Reference>
		<Reference Include="Carbon.Core.Unity">
			<HintPath>$(ManagedDir)\Carbon.Core.Unity.dll</HintPath>
		</Reference>
		<Reference Include="Carbon.Localization.Core">
			<HintPath>$(ManagedDir)\Carbon.Localization.Core.dll</HintPath>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
		</Reference>
		<Reference Include="Unity.Addressables">
			<HintPath>$(ManagedDir)\Unity.Addressables.dll</HintPath>
		</Reference>
		<Reference Include="Unity.Collections">
		  <HintPath>$(ManagedDir)\Unity.Collections.dll</HintPath>
		</Reference>
		<Reference Include="Unity.Entities">
			<HintPath>$(ManagedDir)\Unity.Entities.dll</HintPath>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Core.Runtime">
			<HintPath>$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Unity.RenderPipelines.HighDefinition.Runtime">
			<HintPath>$(ManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Unity.ResourceManager">
			<HintPath>$(ManagedDir)\Unity.ResourceManager.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Nexus\" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(GITHUB_ACTIONS)' != 'true'">
		<Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;D:\Games\Xbox\Hardspace- Shipbreaker\Content\BepInEx\plugins\$(ProjectName)&quot;&#xD;&#xA;copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;D:\Games\Xbox\Hardspace- Shipbreaker\Content\BepInEx\plugins\$(ProjectName)&quot;&#xD;&#xA;copy /Y &quot;$(ProjectDir)\settings.json&quot; &quot;D:\Games\Xbox\Hardspace- Shipbreaker\Content\BepInEx\plugins\$(ProjectName)&quot;" />
	</Target>
</Project>
